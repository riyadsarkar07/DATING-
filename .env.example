# SparkX environment configuration
# Copy to .env and fill in your values. All values are EXPO_PUBLIC_ prefixed so
# they are inlined at build time by Expo. Never commit the real .env file.

# ----- Firebase JS-side configuration (used only as fallback metadata) -----
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sparkx-app
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sparkx-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sparkx-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# ----- Google Sign-In (OAuth Web Client ID) -----
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ----- Deep linking / preview -----
EXPO_PUBLIC_SCHEME=sparkx
