{
  "name": "sparkx-functions",
  "version": "1.0.0",
  "private": true,
  "description": "SparkX secure admin backend + realtime live support (Firebase Cloud Functions)",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
