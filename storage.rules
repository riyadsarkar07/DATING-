rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public read for profile media; only the owner writes/deletes, admins may delete.
    match /users/{userId}/{kind}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && kind in ['photos', 'videos', 'voices']
        && request.resource.size <= 100 * 1024 * 1024
        && (
          kind == 'photos' && request.resource.contentType.matches('image/.*')
          || kind == 'videos' && request.resource.contentType.matches('video/.*')
          || kind == 'voices' && request.resource.contentType.matches('audio/.*')
        );

      allow delete: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Private verification files (selfies / government ID) — never publicly
    // readable. Only the owner uploads and only the owner / admins may read.
    match /users/{userId}/private/verification/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType.matches('image/.*')
        );

      allow delete: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
